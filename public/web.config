<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- L'app e' una Single Page App: esiste solo index.html + JavaScript.
         Le "pagine" dell'app (es. /consenso-wa, /admin-consensi) NON sono
         file fisici sul server: sono indirizzi gestiti dal JavaScript.
         Su Apache il .htaccess fa il fallback; su IIS serve questo web.config:
         quando un percorso non esiste come file, servi index.html e sara'
         il JavaScript a mostrare la pagina giusta. Nessun file mock-up serve. -->
    <httpErrors errorMode="Custom">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" prefixLanguageFilePath="" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
